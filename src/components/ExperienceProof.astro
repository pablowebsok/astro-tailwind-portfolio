---
/**
 * Bloque de confianza basado en categorías y experiencia en proyectos reales
 */
import type { ExperienceProofProps } from '../types'

type Props = ExperienceProofProps

const { title, description, categories, note, subnote } = Astro.props
---

<section class="py-12 relative">
  <div class="absolute inset-0 bg-primary/5 blur-[70px] -z-10"></div>

  <div
    class="p-8 md:p-12 rounded-[2.5rem] bg-midnight/40 backdrop-blur-md border border-primary/15 shadow-aura opacity-0 translate-y-16 transition-all duration-1000"
    data-scroll-animation
  >
    <div class="text-center max-w-2xl mx-auto mb-8">
      <h2 class="text-3xl md:text-4xl font-serif text-cream mb-4 text-balance">
        {title}
      </h2>
      <p class="text-cream/70 text-base font-light leading-relaxed text-pretty">
        {description}
      </p>
    </div>

    <div class="flex flex-wrap justify-center items-center gap-3 md:gap-4 mb-8">
      {
        categories.map(category => (
          <span class="px-5 py-2.5 rounded-full bg-midnight/60 border border-primary/20 text-cream/90 text-sm font-medium tracking-wide shadow-sm transition-all duration-300 hover:border-primary/50 hover:text-primary hover:scale-105">
            {category}
          </span>
        ))
      }
    </div>

    <div class="text-center max-w-xl mx-auto border-t border-primary/10 pt-6 space-y-1.5">
      <p class="text-sage text-sm font-normal text-pretty">
        {note}
      </p>
      <p class="text-cream/60 text-xs font-light leading-relaxed text-pretty">
        {subnote}
      </p>
    </div>
  </div>
</section>
