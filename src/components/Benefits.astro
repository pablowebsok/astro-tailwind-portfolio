---
/**
 * Sección 'Más que una web' (Beneficios para el proyecto)
 */
import type { BenefitProps } from '../types'

interface Props {
  title: string
  subtitle: string
  items: readonly BenefitProps[] | BenefitProps[]
}

const { title, subtitle, items } = Astro.props
---

<section class="py-20 relative">
  <div class="absolute inset-0 bg-primary/5 blur-[60px] -z-10"></div>

  <div class="text-center mb-16">
    <h2
      class="text-4xl font-serif text-cream mb-4 tracking-widest uppercase opacity-0 translate-y-16 transition-all duration-1000"
      data-scroll-animation
    >
      {title}
    </h2>
    <p
      class="text-cream/60 font-light opacity-0 translate-y-16 transition-all duration-1000 delay-200 text-pretty"
      data-scroll-animation
    >
      {subtitle}
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {
      items.map(item => (
        <div
          class="group p-8 rounded-3xl bg-midnight/40 backdrop-blur-md border border-primary/10 opacity-0 translate-y-16 transition-all duration-500 hover:shadow-aura hover:-translate-y-1 hover:bg-midnight/50"
          data-scroll-animation
        >
          {item.icon && (
            <div class="text-3xl mb-4 group-hover:scale-110 transition-transform duration-500 drop-shadow-[0_0_8px_rgba(212,175,55,0.4)]">
              {item.icon}
            </div>
          )}
          <h3 class="text-2xl font-serif text-cream mb-3 transition-colors duration-500 group-hover:text-primary text-balance">
            {item.title}
          </h3>
          <p class="text-cream/70 font-light text-base leading-relaxed text-pretty">
            {item.description}
          </p>
        </div>
      ))
    }
  </div>
</section>
