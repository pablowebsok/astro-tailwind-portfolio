---
/**
 * Componente CTA intermedio para captación antes de llegar al pie
 */
import type { MidCtaProps } from '../types'

type Props = MidCtaProps

const { title, description, buttonText, href } = Astro.props
---

<section class="py-8 relative">
  <div
    class="p-10 md:p-14 rounded-[2.5rem] bg-gradient-to-b from-midnight/80 to-midnight/40 border border-primary/20 backdrop-blur-md text-center relative overflow-hidden shadow-aura opacity-0 translate-y-16 transition-all duration-1000"
    data-scroll-animation
  >
    <div class="absolute inset-0 bg-primary/10 blur-[80px] -z-10 pointer-events-none"></div>

    <h3
      class="text-3xl md:text-4xl font-serif text-cream mb-4 text-balance drop-shadow-[0_0_10px_rgba(245,245,220,0.2)]"
    >
      {title}
    </h3>
    <p
      class="text-cream/75 text-base md:text-lg font-light max-w-xl mx-auto mb-8 leading-relaxed text-pretty"
    >
      {description}
    </p>
    <a
      href={href}
      class="inline-block px-10 py-3.5 rounded-full bg-primary text-midnight text-base font-semibold transition-all duration-500 hover:scale-105 hover:shadow-aura cursor-pointer"
    >
      {buttonText}
    </a>
  </div>
</section>
